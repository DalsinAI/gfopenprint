; $VER: Install-GFOpenPrint @VERSION@ (@DATE@)
; The Installer script for GFOpenPrint (C:Installer / SYS:System/Installer).
; Run it from its icon in the GFOpenPrint package drawer.

(set #version "@VERSION@")
(set @app-name "GFOpenPrint")

(if (< (/ (getversion) 65536) 39)
    (abort "GFOpenPrint needs AmigaOS 3.0 or later."))

(welcome
    (cat "This installs GFOpenPrint " #version ".\n\n"
         "GFOpenPrint prints from this Amiga to printers on your network that "
         "take PDF (IPP), and saves documents as PDF files. GFOpenView opens "
         "pictures and documents and hands them to it."))

(message
    (cat "GFOpenPrint will put:\n\n"
         "GFOpenPrint, OAPPrinters, OAPDiscover, GFOpenView and OAVWorker in C:\n"
         "oapspool.device in DEVS:\n"
         "the GFOpenPrint printer driver in DEVS:Printers\n"
         "the spooler in WBStartup, if you want it\n"
         "and a GFOpenPrint drawer with GFOpenView, Printers and Queue, "
         "a test picture and a test page.\n\n"
         "Files with the same names are replaced."))

(copyfiles
    (prompt "Copying the GFOpenPrint commands to C:")
    (help @copyfiles-help)
    (source "C")
    (dest "C:")
    (all)
    (optional "force"))

(copylib
    (prompt "Copying oapspool.device to DEVS:")
    (help @copylib-help)
    (source "Devs/oapspool.device")
    (dest "DEVS:")
    (confirm))

(copyfiles
    (prompt "Copying the GFOpenPrint printer driver to DEVS:Printers")
    (help @copyfiles-help)
    (source "Devs/Printers/GFOpenPrint")
    (dest "DEVS:Printers")
    (infos)
    (optional "force"))

(if (askbool
        (prompt "Start the GFOpenPrint spooler each time Workbench starts?\n\n"
                "It collects what programs print through printer.device and puts it "
                "in the queue for the Print window.")
        (help "Without the spooler, programs that print through printer.device "
              "with GFOpenPrint chosen in Prefs/Printer have nothing to collect "
              "their pages. GFOpenView and the Print window work either way.")
        (default 1))
    (copyfiles
        (prompt "Copying the spooler to SYS:WBStartup")
        (help @copyfiles-help)
        (source "WBStartup/OAPSpooler")
        (dest "SYS:WBStartup")
        (infos)
        (optional "force")))

(set #where
    (askdir
        (prompt "Where should the GFOpenPrint drawer go?\n"
                "(GFOpenView, Printers and Queue, and the test files)")
        (help @askdir-help)
        (default "SYS:Utilities")))
(set #drawer (tackon #where "GFOpenPrint"))
(makedir #drawer
    (prompt "Making the drawer " #drawer)
    (help @makedir-help))
(copyfiles
    (prompt "Copying the drawer's icon")
    (help @copyfiles-help)
    (source "Icons/GFOpenPrint.info")
    (dest #where)
    (optional "force"))
(copyfiles
    (prompt "Copying GFOpenView, Printers and Queue and the test files")
    (help @copyfiles-help)
    (source "Drawer")
    (dest #drawer)
    (all)
    (optional "force"))
(set @default-dest #drawer)

; Before 4 October 2026 GFOpenPrint was OpenAmigaPrint, and GFOpenView was
; OpenAmigaView. Their old files go to SYS:Storage/GFOpenPrint-Superseded, not
; away; the settings in ENV:OpenAmigaPrint are still read.
(set #old 0)
(if (exists "C:OpenAmigaPrint") (set #old 1))
(if (exists "C:OpenAmigaView") (set #old 1))
(if (exists "DEVS:Printers/OpenAmigaPrint") (set #old 1))
(if (exists (tackon #where "OpenAmigaPrint")) (set #old 1))
; Earlier instructions put copies in SYS:Tools as well.
(if (exists "SYS:Tools/OpenAmigaPrint") (set #old 1))
(if (exists "SYS:Tools/OpenAmigaView") (set #old 1))
(if (exists "SYS:Tools/OAPPrinters") (set #old 1))
(if #old
    (
        (set #store "SYS:Storage/GFOpenPrint-Superseded")
        (if (not (exists #store)) (makedir #store (prompt "Making " #store) (help @makedir-help)))
        (if (exists "C:OpenAmigaPrint")
            (rename "C:OpenAmigaPrint" (tackon #store "OpenAmigaPrint")))
        (if (exists "C:OpenAmigaView")
            (rename "C:OpenAmigaView" (tackon #store "OpenAmigaView")))
        (if (exists "DEVS:Printers/OpenAmigaPrint")
            (rename "DEVS:Printers/OpenAmigaPrint" (tackon #store "OpenAmigaPrint.driver")))
        (if (exists "DEVS:Printers/OpenAmigaPrint.info")
            (rename "DEVS:Printers/OpenAmigaPrint.info" (tackon #store "OpenAmigaPrint.driver.info")))
        (if (exists (tackon #where "OpenAmigaPrint"))
            (rename (tackon #where "OpenAmigaPrint") (tackon #store "OpenAmigaPrint-drawer")))
        (if (exists (tackon #where "OpenAmigaPrint.info"))
            (rename (tackon #where "OpenAmigaPrint.info") (tackon #store "OpenAmigaPrint-drawer.info")))
        (if (exists "SYS:Tools/OpenAmigaPrint")
            (rename "SYS:Tools/OpenAmigaPrint" (tackon #store "Tools-OpenAmigaPrint")))
        (if (exists "SYS:Tools/OpenAmigaPrint.info")
            (rename "SYS:Tools/OpenAmigaPrint.info" (tackon #store "Tools-OpenAmigaPrint.info")))
        (if (exists "SYS:Tools/OpenAmigaView")
            (rename "SYS:Tools/OpenAmigaView" (tackon #store "Tools-OpenAmigaView")))
        (if (exists "SYS:Tools/OpenAmigaView.info")
            (rename "SYS:Tools/OpenAmigaView.info" (tackon #store "Tools-OpenAmigaView.info")))
        (if (exists "SYS:Tools/OAPPrinters")
            (rename "SYS:Tools/OAPPrinters" (tackon #store "Tools-OAPPrinters")))
        (if (exists "SYS:Tools/OAPPrinters.info")
            (rename "SYS:Tools/OAPPrinters.info" (tackon #store "Tools-OAPPrinters.info")))
    ))

(exit
    (cat "GFOpenPrint is installed.\n\n"
         "To try it: open the GFOpenPrint drawer, double-click Picture.png, "
         "and choose Print... in GFOpenView.\n\n"
         "Printers and Queue finds the printers on your network; choose one and "
         "click Use for printing.\n\n"
         "To print from any program: in Prefs/Printer choose the printer type "
         "GFOpenPrint, the port \"device\" and oapspool.device unit 0. "
         "The spooler starts with Workbench next time."
         (if #old
             (cat "\n\nOpenPrint was called OpenAmigaPrint. Its old files are in "
                  "SYS:Storage/GFOpenPrint-Superseded; if Prefs/Printer named "
                  "OpenAmigaPrint, choose GFOpenPrint there now.")
             "")))
